# --- Unity Auto-generated Meta Files ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Unity Crash, Logs & Sysinfo ---
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.dmp

# --- Build Outputs (PC & Mobile) ---
*.app
*.apk
*.aab
*.unitypackage
*.unitypackage.meta

# --- 3D & Audio Software Auto-saves ---
*.blend1
*.blend1.meta

# --- Test Runner ---
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- Gradle (Android builds cache) ---
.gradle/

# --- OS Generated Files (Windows & macOS) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Plastic SCM / Unity Version Control ---
.plastic/

# Unity Profiler captures (local diagnostics only)
ProfilerCaptures/

# Build outputs
Builds/