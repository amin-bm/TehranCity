# --- IDE & Editor Caches (VS, VS Code, Rider) ---
/.vs/
/.vscode/
/.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
