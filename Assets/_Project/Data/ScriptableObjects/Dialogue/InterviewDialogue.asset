  m_Name: InterviewDialogue
  m_EditorClassIdentifier: Assembly-CSharp::InterviewDialogueSO
  employerName: "\u06A9\u0627\u0631\u0641\u0631\u0645\u0627"
  employerLine: "\u0642\u0628\u0644\u0627\u064B \u06A9\u0627\u0631 \u06A9\u0631\u062F\u06CC\u061F
    \u0627\u06CC\u0646\u062C\u0627 \u06A9\u0627\u0631 \u0634\u0648\u062E\u06CC \u0646\u06CC\u0633\u062A.
    \u06CC\u0647 \u0634\u06CC\u0641\u062A \u0622\u0632\u0645\u0627\u06CC\u0634\u06CC\u060C
    \u0627\u06AF\u0647 \u062E\u0631\u0627\u0628 \u0646\u06A9\u0646\u06CC \u0627\u062F\u0627\u0645\u0647
    \u0645\u06CC\u062F\u06CC\u0645."
  acceptLabel: "\u0642\u0628\u0648\u0644 \u0645\u06CC\u200C\u06A9\u0646\u0645"
  rejectLabel: "\u0628\u0639\u062F\u0627\u064B \u0641\u06A9\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0645"
  acceptedLine: "\u062E\u0648\u0628\u0647. \u0641\u0639\u0644\u0627\u064B \u0627\u0632
    \u0647\u0645\u06CC\u0646 \u0627\u0645\u0631\u0648\u0632 \u0634\u0631\u0648\u0639
    \u06A9\u0646. \u0635\u0646\u062F\u0648\u0642 \u0648 \u0642\u0641\u0633\u0647
    \u0631\u0648 \u062A\u0645\u06CC\u0632 \u0646\u06AF\u0647 \u062F\u0627\u0631."
  rejectedLine: "\u0628\u0627\u0634\u0647. \u0627\u06AF\u0647 \u067E\u0634\u06CC\u0645\u0648\u0646
    \u0634\u062F\u06CC\u060C \u062A\u0627 \u0622\u062E\u0631 \u0647\u0641\u062A\u0647
    \u0648\u0642\u062A \u062F\u0627\u0631\u06CC."
  jobAcceptedFlag: jobAccepted
